{
  "name": "kiro-code-translator",
  "displayName": "Kiro Code Translator",
  "description": "Smart, On-Demand Code Conversion Extension for VS Code",
  "version": "1.0.0",
  "publisher": "kiro",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages", "Other"],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kiro-code-translator.convertToPython",
        "title": "Convert Code Language-python"
      },
      {
        "command": "kiro-code-translator.convertToC",
        "title": "Convert Code Language-c"
      },
      {
        "command": "kiro-code-translator.convertToCpp",
        "title": "Convert Code Language-cpp"
      },
      {
        "command": "kiro-code-translator.convertToJava",
        "title": "Convert Code Language-java"
      },
      {
        "command": "kiro-code-translator.convertToJs",
        "title": "Convert Code Language-js"
      }
    ]
  },
  "scripts": {
    "test": "node test/test_runner.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x"
  }
}